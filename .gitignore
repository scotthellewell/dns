# Compiled binaries
dns
dnsserver
dns-server
dns-server-*
# ...but systemd unit files are config, not binaries. The unanchored
# 'dns-server-*' above silently excluded these, so deploy.sh shipped
# referencing files that were never committed.
!configs/systemd/dns-server-*.service
dns-linux*
e2e.test
__debug_bin*

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test

# Output of go coverage
*.out
coverage.html

# Go workspace file
go.work
go.work.sum

# IDE/Editor directories
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Build artifacts
*.tar.gz
dist/

# Web build output
web/dist/
web/node_modules/
web/.angular/
web/.tmp/
web/playwright-report/
web/test-results/

# Playwright
playwright/.cache/
.credentials
# API keys and other secrets - never commit
api-key.txt
*api-key*.txt
*.key
!ssl-dhparams.pem
# Environment files (contain secrets)
.env
.env.*

# Database files (NEVER commit these - contain sensitive data)
*.db
*.db-journal
*.db-shm
*.db-wal
data.db
*.bolt
*.bbolt
# Allow README in data directory
!data/README.md